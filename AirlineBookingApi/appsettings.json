{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AirlineBookingDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "// SecretKey": "Demo key cho PBL3. Production phai doc tu environment variable hoac secret store.",
    "SecretKey": "PBL3_AirlineBooking_SecretKey_1234567890_ABCDEF",
    "Issuer": "AirlineBookingApi",
    "Audience": "AirlineBookingClient",
    "ExpiryInMinutes": 120
  },
  "Booking": {
    "// OverbookingRatio": "Tỷ lệ oversell — 1.10 = cho phép bán tối đa 110% sức chứa thật để bù no-show (~5–15%).",
    "OverbookingRatio": 1.10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}